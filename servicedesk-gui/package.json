{
    "name": "servicedesk-gui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "tsc": "tsc --noEmit -p tsconfig.app.json",
        "lint": "eslint .",
        "lint-fix": "eslint --fix .",
        "prettier": "prettier -c \"{**/*,*}.{ts,tsx,json,js,md,html,scss}\"",
        "prettier-fix": "prettier --write \"{**/*,*}.{ts,tsx,json,js,md,html,scss}\"",
        "check": "yarn tsc && yarn lint && yarn prettier",
        "preview": "vite preview",
        "test": "vitest"
    },
    "dependencies": {
        "@myconext/shared-gui": "*",
        "@phosphor-icons/react": "^2.1.10",
        "@surfnet/curve-react": "^0.10.0",
        "i18n-js": "^4.5.1",
        "js-cookie": "^3.0.8",
        "react": "^19.2.7",
        "react-datepicker": "^9.1.0",
        "react-dom": "^19.2.7",
        "react-router-dom": "7.18.1",
        "react-tooltip": "^6.0.9",
        "sonner": "^2.0.8",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.0.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "http-proxy-middleware": "^4.2.1",
        "prettier": "^3.9.9",
        "sass": "^1.90.0",
        "typescript": "npm:@typescript/typescript6@^6.0.0",
        "typescript-7": "npm:typescript@^7.0.0",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.0.10",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^5.0.5"
    }
}
