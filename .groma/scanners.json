{
  "scanners": [
    {
      "id": "java",
      "source": "@groma/scanner-java@0.2.1",
      "include": [
        "**/*.java",
        "**/pom.xml",
        "**/build.gradle",
        "**/build.gradle.kts",
        "**/settings.gradle",
        "**/settings.gradle.kts"
      ],
      "exclude": [
        "target/",
        "build/",
        ".gradle/",
        "**/src/test/**",
        "myconext-performance-test/",
        "tiqr-mock/"
      ]
    },
    {
      "id": "javascript",
      "source": "@groma/scanner-javascript@0.2.1",
      "include": [
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.min.js",
        "*.min.mjs",
        "*.min.cjs",
        "*.min.jsx",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/",
        "**/__tests__/**",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/src/test/**",
        "myconext-performance-test/",
        "**/*.config.js",
        "**/*.config.cjs",
        "**/eslint.config.js",
        "**/vite.config.js",
        "**/babel.config.cjs",
        "**/svelte.config.js"
      ]
    },
    {
      "id": "react",
      "source": "@groma/scanner-react@0.2.1",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/",
        "**/*.config.ts",
        "**/vite.config.ts",
        "**/react-router.config.ts",
        "**/eslint.config.js"
      ]
    },
    {
      "id": "typescript",
      "source": "@groma/scanner-typescript@0.2.2",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/",
        "**/*.config.ts",
        "**/vite.config.ts",
        "**/react-router.config.ts",
        "**/eslint.config.js"
      ]
    }
  ]
}
