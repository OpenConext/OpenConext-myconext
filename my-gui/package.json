{
    "name": "my-gui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "tsc": "tsc --noEmit -p tsconfig.app.json",
        "lint": "eslint .",
        "lint-fix": "eslint --fix .",
        "prettier": "prettier -c \"{**/*,*}.{ts,tsx,json,js,md,html,scss}\"",
        "prettier-fix": "prettier --write \"{**/*,*}.{ts,tsx,json,js,md,html,scss}\"",
        "check": "yarn tsc && yarn lint && yarn prettier",
        "preview": "vite preview",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@surfnet/curve-react": "^0.8.2",
        "@tanstack/react-query": "^5.104.0",
        "@tanstack/react-query-devtools": "^5.104.0",
        "i18n-js": "^4.5.4",
        "isbot": "^5",
        "js-cookie": "^3.0.8",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "^8.5.0",
        "sonner": "^2.0.8",
        "timeago.js": "^4.0.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@react-router/dev": "^8.5.0",
        "@react-router/fs-routes": "^8.5.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "prettier": "^3.9.9",
        "sass-embedded": "^1.105.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.3.3"
    }
}
